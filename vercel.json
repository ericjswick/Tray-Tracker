{
  "version": 2,
  "public": true,
  "functions": {
    "api/notifications.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/notifications/(.*)", "destination": "/api/notifications" },
    { "source": "/api/notifications", "destination": "/api/notifications" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
